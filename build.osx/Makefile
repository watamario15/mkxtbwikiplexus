CC=clang
CXX=clang++
LD=clang++

XZ_PREFIX?=$(shell brew --prefix xz)
MECAB_PREFIX?=$(shell brew --prefix mecab)
KAKASI_PREFIX?=/usr/local

CCFLAGS=-Wall -O3 -D_LARGEFILE_SOURCE=1 -D_LARGEFILE64_SOURCE=1 -D_FILE_OFFSET_BITS=64 -DNDEBUG -I$(XZ_PREFIX)/include -I$(MECAB_PREFIX)/include -I$(KAKASI_PREFIX)/include
CXXFLAGS=$(CCFLAGS)

LDLIBS_WIKIPLEXUS=-lxml2
LDLIBS_INDEX=
LDLIBS_IMAGECOMPLEX=$(LDLIBS_WIKIPLEXUS)
LDLIBS_YOMI=-L$(MECAB_PREFIX)/lib -lmecab $(KAKASI_PREFIX)/lib/libkakasi.a -liconv
LDLIBS_MKRAX=$(XZ_PREFIX)/lib/liblzma.a

TARGETPOSTFIX=-bin
SRCDIR=..
include $(SRCDIR)/Makefile.i
